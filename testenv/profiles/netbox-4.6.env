NETBOX_IMAGE=docker.io/netboxcommunity/netbox:v4.6.10-5.0.2
PLUGIN_REQUIREMENTS="netbox-plugin-dns==1.6.2 netbox-data-flows==1.5.4"
PORT=8146
# netbox-docker 5.0.x serves 4 requests at a time (Granian, 4 workers, one
# thread each); parallel providers exhaust it. Match the 5.1.x defaults.
NETBOX_EXTRA_ENV="GRANIAN_BLOCKING_THREADS=4 GRANIAN_BACKPRESSURE=16"
